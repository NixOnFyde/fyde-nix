From: fyde-nix
Subject: [PATCH] power: supply: bq25700: handle unclassified legacy input

Use the USB2 PHY extcon for BC1.2 charger-type events and conservative
limits for SDP, CDP, and DCP sources. If the PHY reports no charger type,
use a safe SDP fallback when the charger detects input. Refresh the cached
charger state on input detection, and mark negotiated PD input to prevent
the fallback from overriding its current limit.

diff --git a/arch/arm64/boot/dts/rockchip/rk3588s-fydetab_duo.dts b/arch/arm64/boot/dts/rockchip/rk3588s-fydetab_duo.dts
--- a/arch/arm64/boot/dts/rockchip/rk3588s-fydetab_duo.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588s-fydetab_duo.dts
@@ -1164,16 +1164,16 @@
     otg-mode-en-gpios = <&gpio4 RK_PA6 GPIO_ACTIVE_HIGH>;
     pinctrl-names = "default";
     pinctrl-0 = <&charger_ok>;
-    extcon = <&usbc0>;
+    extcon = <&u2phy0>;
     ti,battery = <&battery>;
     ti,charge-current = <2500000>;
     ti,max-input-voltage = <20000000>;
     ti,max-input-current = <5000000>;
     ti,max-charge-voltage = <13200000>;
     ti,input-current = <3000000>;
-    ti,input-current-sdp = <3000000>;
-    ti,input-current-dcp = <3000000>;
-    ti,input-current-cdp = <3000000>;
+    ti,input-current-sdp = <500000>;
+    ti,input-current-dcp = <1500000>;
+    ti,input-current-cdp = <1500000>;
     ti,minimum-sys-voltage = <9216000>;
     ti,otg-voltage = <5000000>;
     ti,otg-current = <3000000>;
diff --git a/drivers/power/supply/bq25700_charger.c b/drivers/power/supply/bq25700_charger.c
--- a/drivers/power/supply/bq25700_charger.c
+++ b/drivers/power/supply/bq25700_charger.c
@@ -1463,0 +1464,1 @@
+	bq->typec0_status = USB_STATUS_PD;
@@ -1516,0 +1518,13 @@
+		/*
+		 * Some legacy USB sources do not produce a BC1.2 extcon event.
+		 * Keep their fallback conservative, but do not leave the charger
+		 * disabled after the delayed initialization work set zero currents.
+		 */
+		if (charger->typec0_status != USB_STATUS_PD &&
+		    charger->typec1_status != USB_STATUS_PD &&
+		    charger->cable_edev &&
+		    extcon_get_state(charger->cable_edev, EXTCON_CHG_USB_SDP) <= 0 &&
+		    extcon_get_state(charger->cable_edev, EXTCON_CHG_USB_DCP) <= 0 &&
+		    extcon_get_state(charger->cable_edev, EXTCON_CHG_USB_CDP) <= 0)
+			bq25700_enable_charger(charger,
+					       charger->init_data.input_current_sdp);
