From: fyde-nix
Subject: [PATCH] rknpu: map NPU registers without reserving IOMMU windows

The RK IOMMU driver claims the 64K MMU windows that fall inside the NPU's
memory regions. devm_ioremap_resource() therefore fails with -EBUSY and
logs "can't request region for resource" on every boot; the driver then
fell back to devm_ioremap() anyway. Map the pages directly, which is all
the driver needs, and treat a NULL mapping as an error.

--- a/drivers/rknpu/rknpu_drv.c
+++ b/drivers/rknpu/rknpu_drv.c
@@ -1305,16 +1305,18 @@
 			return -ENXIO;
 		}
 
-		rknpu_dev->base[i] = devm_ioremap_resource(dev, res);
-		if (PTR_ERR(rknpu_dev->base[i]) == -EBUSY) {
-			rknpu_dev->base[i] = devm_ioremap(dev, res->start,
-							  resource_size(res));
-		}
-
-		if (IS_ERR(rknpu_dev->base[i])) {
+		/*
+		 * The RK IOMMU driver reserves the 64K windows that fall inside the
+		 * NPU's memory regions, so devm_ioremap_resource() fails with -EBUSY
+		 * and logs a spurious "can't request region for resource" error on
+		 * every boot. Mapping the pages is all this driver needs.
+		 */
+		rknpu_dev->base[i] = devm_ioremap(dev, res->start,
+						  resource_size(res));
+		if (!rknpu_dev->base[i]) {
 			LOG_DEV_ERROR(dev,
 				      "failed to remap register for rknpu\n");
-			return PTR_ERR(rknpu_dev->base[i]);
+			return -ENOMEM;
 		}
 	}
 
