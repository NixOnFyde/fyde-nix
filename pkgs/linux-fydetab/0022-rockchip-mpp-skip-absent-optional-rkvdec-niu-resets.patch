From: FydeTab Duo NixOS
Subject: [PATCH] video: rockchip: mpp: skip absent optional RKVDEC NIU resets

The RK3588 RKVDEC nodes on the FydeTab Duo do not declare dedicated or
shared NIU reset controls. The MPP driver treats these controls as optional
and continues probing without them, but currently calls the reset lookup
unconditionally, which logs two error messages per decoder core. Only query
the controls when the device tree declares them; retain the existing error
report if a declared reset cannot be acquired.

---
 drivers/video/rockchip/mpp/mpp_rkvdec2.c | 26 ++++++++++++++++++++------
 1 file changed, 20 insertions(+), 6 deletions(-)

diff --git a/drivers/video/rockchip/mpp/mpp_rkvdec2.c b/drivers/video/rockchip/mpp/mpp_rkvdec2.c
--- a/drivers/video/rockchip/mpp/mpp_rkvdec2.c
+++ b/drivers/video/rockchip/mpp/mpp_rkvdec2.c
@@ -1181,11 +1181,25 @@ static int rkvdec2_init(struct mpp_dev *mpp)
 	if (!dec->rst_h)
 		mpp_err("No hclk reset resource define\n");
-	dec->rst_niu_a = mpp_reset_control_get(mpp, RST_TYPE_NIU_A, "niu_a");
-	if (!dec->rst_niu_a)
-		mpp_err("No niu aclk reset resource define\n");
-	dec->rst_niu_h = mpp_reset_control_get(mpp, RST_TYPE_NIU_H, "niu_h");
-	if (!dec->rst_niu_h)
-		mpp_err("No niu hclk reset resource define\n");
+	if (of_property_match_string(mpp->dev->of_node,
+				     "reset-names", "niu_a") >= 0 ||
+	    of_property_match_string(mpp->dev->of_node, "reset-names",
+				     "shared_niu_a") >= 0) {
+		dec->rst_niu_a = mpp_reset_control_get(mpp, RST_TYPE_NIU_A, "niu_a");
+		if (!dec->rst_niu_a)
+			mpp_err("No niu aclk reset resource define\n");
+	} else {
+		dec->rst_niu_a = NULL;
+	}
+	if (of_property_match_string(mpp->dev->of_node,
+				     "reset-names", "niu_h") >= 0 ||
+	    of_property_match_string(mpp->dev->of_node, "reset-names",
+				     "shared_niu_h") >= 0) {
+		dec->rst_niu_h = mpp_reset_control_get(mpp, RST_TYPE_NIU_H, "niu_h");
+		if (!dec->rst_niu_h)
+			mpp_err("No niu hclk reset resource define\n");
+	} else {
+		dec->rst_niu_h = NULL;
+	}
 	dec->rst_core = mpp_reset_control_get(mpp, RST_TYPE_CORE, "video_core");
 	if (!dec->rst_core)
 		mpp_err("No core reset resource define\n");
