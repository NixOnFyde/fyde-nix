During hibernation, create_image() freezes all devices, takes a memory
snapshot, then thaws them so swsusp_write() can write the image to disk.

The original SET_SYSTEM_SLEEP_PM_OPS maps .freeze to
pm_runtime_force_suspend, which powers off the MicroSD controller before
swsusp_write() can trigger block I/O, which deadlocks the kernel.

Fix by adding our own .freeze callback that calls pm_runtime_resume()
to synchronously wake the controller if it was autosuspended. Unlike
pm_runtime_force_resume(), pm_runtime_resume() does not change
disable_depth, avoiding the "Unbalanced pm_runtime_enable" warning.

.thaw and .restore both re-init the controller using a shared helper
to handle the case where genpd powers off the SDMMC domain during the
noirq stage after .freeze. In that case RPM believes the device is
active but the hardware registers are kaboomed; reinit using
dw_mci_runtime_resume() (clocks, reset, DMA, bus setup, CD/SDIO IRQ)
is required. .poweroff still does shuts down the controller before
system poweroff.

---
 drivers/mmc/host/dw_mmc-rockchip.c | 66 ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 65 insertions(+), 1 deletion(-)

diff --git a/drivers/mmc/host/dw_mmc-rockchip.c b/drivers/mmc/host/dw_mmc-rockchip.c
--- a/drivers/mmc/host/dw_mmc-rockchip.c
+++ b/drivers/mmc/host/dw_mmc-rockchip.c
@@ -631,9 +631,73 @@ static void dw_mci_rockchip_remove(struct platform_device *pdev)
 }
 
+static int dw_mci_rockchip_reinit(struct device *dev)
+{
+	int ret;
+
+	/* Disable RPM first to avoid unbalanced pm_runtime_enable() in
+	 * pm_runtime_force_resume(). Then mark suspended and set
+	 * needs_force_resume so force_resume() does not skip ->runtime_resume. */
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	dev->power.needs_force_resume = 1;
+
+	ret = pm_runtime_force_resume(dev);
+	if (ret < 0)
+		return ret;
+	return 0;
+}
+
+static int dw_mci_rockchip_freeze(struct device *dev)
+{
+	int ret;
+
+	/* If the SD controller was autosuspended when idle, wake it up
+	 * synchronously so it is clocked and ready for swsusp_write.
+	 * pm_runtime_resume() returns 1 if already active, 0 if it
+	 * successfully resumed, -EACCES if RPM disabled (returned as
+	 * failure since controller would be off). */
+	ret = pm_runtime_resume(dev);
+	if (ret < 0)
+		return ret;
+
+	return 0;
+}
+
+static int dw_mci_rockchip_thaw(struct device *dev)
+{
+	/* Re-init after potential genpd power-off at noirq stage. */
+	return dw_mci_rockchip_reinit(dev);
+}
+
+static int dw_mci_rockchip_restore(struct device *dev)
+{
+	/* Re-init after cold boot from hibernation image. */
+	return dw_mci_rockchip_reinit(dev);
+}
+
 static const struct dev_pm_ops dw_mci_rockchip_dev_pm_ops = {
-	SET_SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend,
-				pm_runtime_force_resume)
+	.suspend = pm_runtime_force_suspend,
+	.resume = pm_runtime_force_resume,
+	/* .freeze wakes the controller so swsusp_write() can issue
+	 * block I/O while it is powered, clocked, and SDR104-tuned. */
+	.freeze = dw_mci_rockchip_freeze,
+	/* .thaw re-inits if genpd powered off the SDMMC domain at noirq. */
+	.thaw = dw_mci_rockchip_thaw,
+	.poweroff = pm_runtime_force_suspend,
+	/* .restore re-inits after cold boot from hibernation image. */
+	.restore = dw_mci_rockchip_restore,
 	SET_RUNTIME_PM_OPS(dw_mci_runtime_suspend,
 			   dw_mci_runtime_resume,
 			   NULL)
 };
